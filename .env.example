# Configuração de uma instância (uma empresa cliente por deploy).
# Copie para .env em desenvolvimento; em produção use as variáveis do provedor.

# Obrigatórias em produção (a aplicação não sobe sem elas)
SECRET_KEY=troque-por-um-valor-longo-e-aleatorio
ALLOWED_HOSTS=nutri.suaempresa.com.br

# Banco desta empresa (cada instância tem o seu)
DATABASE_URL=postgres://usuario:senha@localhost:5432/nutri

# Opcionais
DEBUG=False
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
# Ativar somente se TODOS os subdomínios servirem HTTPS (efeito difícil de reverter)
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SESSION_COOKIE_AGE=43200
CONN_MAX_AGE=60
# Cookies "Secure" — desligue APENAS para conferir o modo produção em http://localhost
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Leitura da tabela nutricional por foto (Gemini). Sem chave, o recurso fica oculto.
# Chave em https://aistudio.google.com → "Get API key".
# GEMINI_API_KEY=
# GEMINI_MODELO=gemini-3.6-flash
# GEMINI_RACIOCINIO=low
# GEMINI_TIMEOUT=45

# Provisionamento inicial (bootstrap_instancia) — alternativa a --senha
# INSTANCIA_ADMIN_SENHA=senha-do-primeiro-administrador
